# Copy to .env on the VM and fill these in. Never commit .env.
#
#   cp .env.example .env
#   nano .env
#
# docker compose -f docker-compose.prod.yml reads it automatically.

# ---- Public endpoint -------------------------------------------------------
# DNS: an A record for this name must point at the VM's static IP.
DOMAIN=vtuber.example.com
ACME_EMAIL=you@example.com

# ---- Security (A22) --------------------------------------------------------
# Every WebSocket handshake (/client-ws, /proxy-ws) and /api/metrics call must
# present this token. Generate one with:
#   openssl rand -base64 32
# The same value goes into $env:VTUBER_WS_TOKEN on the operator's PC.
VTUBER_WS_TOKEN=change-me-32-bytes

# Origin allowed by CORS. Must match the public URL, without a trailing slash.
VTUBER_CORS_ORIGINS=https://vtuber.example.com

# ---- Optional --------------------------------------------------------------
# Scheduler timezone (the jobs' cron expressions are interpreted here).
TZ=Europe/Madrid
# Image tag, useful to keep two builds around.
APP_TAG=poc
# Mirror for the uv image if ghcr.io is unreachable from the VM:
# UV_IMAGE=ghcr.nju.edu.cn/astral-sh/uv:latest
